# Salin file ini menjadi .env.local lalu sesuaikan dengan backend kamu.
# .env.local TIDAK ikut git (lihat .gitignore).

# Root situs WordPress.
# Dipakai next.config.ts untuk menyusun images.remotePatterns.
# WAJIB tersedia saat build -- kalau kosong, build tetap sukses
# tapi SEMUA gambar produk gagal tampil.
NEXT_PUBLIC_WORDPRESS_URL=https://wordpress-api.test

# Endpoint GraphQL versi publik. Prefix NEXT_PUBLIC_ berarti
# nilainya ikut ter-bundle ke browser, jadi jangan taruh rahasia di sini.
NEXT_PUBLIC_WORDPRESS_API_URL=https://wordpress-api.test/graphql

# Endpoint yang dipakai Server Component, Server Action, dan Route Handler.
# Tanpa prefix NEXT_PUBLIC_ = tidak pernah dikirim ke browser.
WORDPRESS_API_URL=https://wordpress-api.test/graphql
